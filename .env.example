# ══════════════════════════════════════════════════════════
# ThinkAIQ CRM — Environment Configuration
# ══════════════════════════════════════════════════════════
# Copy to .env and fill in values.
# All apps (web, api, worker) read from this single file.
# Default product identity: ThinkAIQ CRM (see docs/architecture/PLATFORM_IDENTITY_AND_BRANDING.md).
# Package names may still use @vencore/* (foundation); customer-facing brand is ThinkAIQ.

# ── Compose / Docker ──────────────────────────────────────
# Controls which images docker compose uses.
# Dev:  leave defaults (builds from local Dockerfiles)
# Demo: ghcr.io/vencorehq/vencore-{app}:demo
# Prod: ghcr.io/vencorehq/vencore-{app}:latest
WEB_IMAGE=vencore-web:local
API_IMAGE=vencore-api:local
WORKER_IMAGE=vencore-worker:local
DB_IMAGE=timescale/timescaledb:latest-pg15

# ── Database ──────────────────────────────────────────────
DB_USER=vencore
DB_PASSWORD=vencore
DB_NAME=vencore
# App / staging / production SoR — NEVER point this at an isolation/test database.
DATABASE_URL=postgresql://vencore:vencore@localhost:5432/vencore
# Fresh local staging example (created empty, migrated from zero):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/thinkaiq_staging
#
# Live isolation tests ONLY — never use as DATABASE_URL for the running app.
# Requires NODE_ENV=test and ALLOW_LIVE_DB_TESTS=1
# Local Windows Postgres example: postgresql://postgres:postgres@localhost:5432/vencore_isolation_test
# Docker compose example: postgresql://vencore:vencore@localhost:5432/vencore_isolation_test
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/vencore_isolation_test
ALLOW_LIVE_DB_TESTS=0
# App Redis (BullMQ). Prefer Railway public TCP proxy from local Windows; use *.railway.internal only in-Railway.
# REDIS_URL=redis://default:<password>@altaria.proxy.rlwy.net:<port>
# REDIS_URL=redis://default:<password>@redis.railway.internal:6379
# Windows Redis 7 sidecars often use 6380 — see docs/operations/REDIS-JOB-RUNTIME.md
REDIS_URL=redis://127.0.0.1:6380
# Job runtime: bullmq (target) | legacy (temporary interval pollers)
JOBS_RUNTIME=bullmq
# Queue integration tests ONLY — never production Redis
# REDIS_URL_TEST=redis://127.0.0.1:6379/15
# ALLOW_LIVE_QUEUE_TESTS=0

# ── Object storage (Cloudflare R2 / S3-compatible) ────────
# Optional in boot; messaging presign + cloud document put require these.
# Local PDF fallback: apps/api/storage/tenants/{workspaceId}/documents/...
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=

# ── SMTP (notification bus / password reset env relay) ────
# Optional; setup wizard can also store SMTP in system_settings.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
# SMTP_SECURE=false

# ── Cookies (production) ──────────────────────────────────
# In NODE_ENV=production cookies are Secure unless COOKIE_SECURE=false
# COOKIE_SECURE=true

# ── App URLs ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NODE_ENV=development

# ── Auth ──────────────────────────────────────────────────
JWT_SECRET=b3e21015a0b4aa660f0fa7104aeaf730dc20d3f104c40db2d255ebacbd56097c

# ── Clerk ─────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/pipeline
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/pipeline

# ── Stripe ────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Google OAuth ──────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/mail/accounts/gmail/callback

# ── SSH Management ────────────────────────────────────────
# 32-byte hex: openssl rand -hex 32
SSH_ENCRYPTION_KEY=461a7ca7ed069285134c3276d7c58b6cfe568cd3d1db4b7e7c858524b8483a2f

# ── Mail ──────────────────────────────────────────────────
# 32-byte hex: openssl rand -hex 32
MAIL_ENCRYPTION_KEY=dcabed4de7e1e1e324647fc9f8897d4b3da99cba5a0fca9506102689fb3a374f

# ── Internal Secrets ──────────────────────────────────────
# Generate each: openssl rand -hex 32
AGENT_SIGNING_SECRET=change_me_in_production
CRON_SECRET=b1a5cb139d5e08c74db2335a7b91af766688f438f3b29d5328c7d6e749ec0ce2

# ── Marketplace ───────────────────────────────────────────
MARKETPLACE_API_URL=https://marketplace.vencore.dev
MARKETPLACE_SERVICE_TOKEN=

# ── Plugin CDN ────────────────────────────────────────────
NEXT_PUBLIC_PLUGIN_CDN_URL=https://plugin-cdn.vencore.dev

# ── Config ────────────────────────────────────────────────
CONFIG_PATH=../../vencore.config.json

# ── Dev-only ──────────────────────────────────────────────
DEMO_SEED=false
